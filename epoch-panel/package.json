{
  "name": "epoch-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Epoch team panel: admin, team members, software assignments, customers, payments and the 30-day task board",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "setup": "prisma db push && node prisma/seed.js",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "express": "5.1.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
